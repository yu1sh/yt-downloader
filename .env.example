# Cloudflare Tunnelなどで公開するホスト名。
DOMAIN=yt.example.com

# openssl rand -hex 32 で生成した値に変更してください。
APP_ENV=production
APP_SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=true

# 必要に応じて上限を調整できます。
MAX_DURATION_SECONDS=7200
MAX_JOB_BYTES=4294967296
MAX_PENDING_PER_USER=3
MAX_PENDING_TOTAL=20
MIN_FREE_BYTES=5368709120
FILE_TTL_SECONDS=86400
HISTORY_TTL_SECONDS=604800
JOB_TIMEOUT_SECONDS=7200
